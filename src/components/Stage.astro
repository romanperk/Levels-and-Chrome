---
import type { Guide } from '../lib/schema';

interface Props {
  stage: Guide['cyberwareStages'][number];
  cyberwareNames: Record<string, string>;
}

const { stage, cyberwareNames } = Astro.props;
---

<div class="my-4 border p-4">
  <h3 class="font-bold">Get for this stage</h3>

  <h4 class="mt-3 font-semibold">Weapon slots</h4>
  <ul>
    {stage.weaponSlots.map((w) => (
      <li>
        <strong>Slot {w.slot}: {w.name}.</strong> {w.where}. {w.why}
        {w.dualWith && <><br /><strong>Dual-wield with {w.dualWith.name}.</strong> {w.dualWith.where}. {w.dualWith.why}</>}
      </li>
    ))}
  </ul>

  {stage.cyberware.length > 0 && (
    <>
      <h4 class="mt-3 font-semibold">Cyberware</h4>
      <ul>
        {stage.cyberware.map((c) => (
          <li><strong>{cyberwareNames[c.id] ?? c.id}, Tier {c.tier}.</strong> {c.where}. {c.why}</li>
        ))}
      </ul>
    </>
  )}

  {stage.gear.length > 0 && (
    <>
      <h4 class="mt-3 font-semibold">Gear</h4>
      <ul>
        {stage.gear.map((g) => (
          <li><strong>{g.name}.</strong> {g.where}. {g.why}</li>
        ))}
      </ul>
    </>
  )}
</div>
