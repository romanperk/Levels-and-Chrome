---
import type { Cyberware, Guide } from '../lib/schema';

interface Props {
  stage: Guide['cyberwareStages'][number];
  cyberware: Record<string, Cyberware>;
}

const { stage, cyberware } = Astro.props;
---

<div class="cut-tr flex flex-col gap-6 border border-line bg-panel p-5 sm:p-7">
  <h3 class="label text-[13px] text-chrome">// Your setup by level {stage.to}</h3>

  {stage.cyberware.length > 0 && (
    <div class="flex flex-col gap-2.5">
      <h4 class="font-display text-xl font-bold uppercase">Cyberware</h4>
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(260px,100%),1fr))] gap-2.5">
        {stage.cyberware.map((c) => (
          <li class="flex flex-col gap-1.5 border border-line bg-night px-4 py-3.5">
            <div class="flex items-baseline justify-between gap-2">
              <span class="text-base font-semibold">{cyberware[c.id]?.name ?? c.id}</span>
              <span class="font-mono text-xs whitespace-nowrap text-hud uppercase">T{c.tier}{cyberware[c.id] && ` · ${cyberware[c.id].slot}`}</span>
            </div>
            <p class="text-sm leading-snug text-muted">{c.why}</p>
            <p class="font-mono text-xs leading-relaxed text-soft">→ {c.where}</p>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="flex flex-col gap-2.5">
    <h4 class="font-display text-xl font-bold uppercase">Weapon slots</h4>
    <ul class="flex flex-col gap-3.5">
      {stage.weaponSlots.map((w) => (
        <li class="grid grid-cols-[40px_minmax(0,1fr)] gap-3 border-t border-line pt-3.5 sm:grid-cols-[52px_minmax(0,1fr)] sm:gap-4">
          <span class="flex size-10 items-center justify-center border border-hud font-display text-xl font-bold text-hud sm:size-13 sm:text-[26px]" aria-label={`Slot ${w.slot}`}>{w.slot}</span>
          <div class="flex min-w-0 flex-col gap-1.5">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="text-lg font-semibold">{w.name}</span>
              {w.dualWith && <span class="label bg-chrome px-2 py-0.5 text-[11px] text-night">×2 Dual-wield</span>}
            </div>
            <p class="text-[15px] leading-normal text-soft">{w.why}</p>
            <p class="font-mono text-xs leading-relaxed text-muted">→ {w.where}</p>
            {w.dualWith && (
              <div class="mt-1 border-l-2 border-chrome pl-3">
                <p class="text-[15px] leading-normal"><strong>Second gun: {w.dualWith.name}.</strong> {w.dualWith.why}</p>
                <p class="font-mono text-xs leading-relaxed text-muted">→ {w.dualWith.where}</p>
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>

  {stage.gear.length > 0 && (
    <div class="flex flex-col gap-2.5">
      <h4 class="font-display text-xl font-bold uppercase">Gear</h4>
      <ul class="flex flex-col gap-3">
        {stage.gear.map((g) => (
          <li class="border-t border-line pt-3">
            <p class="text-base font-semibold">{g.name}</p>
            <p class="text-[15px] leading-normal text-soft">{g.why}</p>
            <p class="font-mono text-xs leading-relaxed text-muted">→ {g.where}</p>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
