---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main class="mx-auto max-w-2xl p-4"><slot /></main>
    <footer class="mx-auto max-w-2xl p-4 text-sm">
      <p>This is an unofficial fan work and is not approved/endorsed by CD PROJEKT RED</p>
    </footer>
  </body>
</html>
